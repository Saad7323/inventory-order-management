<!doctype html><html lang="en"><head><meta charset="utf-8"><link rel="stylesheet" href="/styles.css"><title>Order confirmed</title></head><body><main><h1>Order #<%= order.id %> confirmed</h1><p>Customer: <%= order.customer_name %></p><table><thead><tr><th>Product</th><th>Quantity</th><th>Unit price</th></tr></thead><tbody><% items.forEach(item => { %><tr><td><%= item.name %></td><td><%= item.quantity %></td><td>$<%= item.unit_price.toFixed(2) %></td></tr><% }) %></tbody></table><p><strong>Total: $<%= order.total_amount.toFixed(2) %></strong></p><p><a href="/">Return to inventory</a></p></main></body></html>
