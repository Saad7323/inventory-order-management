<%- include('partials/start') %><% const supplier=type==='suppliers'; %><a class="back-link"
  href="/<%= type %><%= contact?'/'+contact.id:'' %>"><%- icon('arrow') %>Back to <%= contact?contact.name:type %></a>
<section class="page-heading">
  <div>
    <div class="eyebrow">KEEP YOUR CONNECTIONS CLOSE</div>
    <h1><%= title %><span class="title-dot">.</span></h1>
    <p>A few details now. A better relationship later.</p>
  </div>
</section>
<div class="detail-layout">
  <form class="card form-card stack-form" method="post" action="/<%= type %><%= contact?'/'+contact.id:'' %>">
    <%- include('partials/csrf') %><div>
      <h2>Contact details</h2>
      <p class="section-subtitle">You can update these details as things change.</p>
    </div>
    <div class="form-grid"><label class="span-2"><%= supplier?'Company name':'Full name' %><input name="name" required maxlength="160"
          value="<%= contact?.name||'' %>"
          placeholder="<%= supplier?'e.g. Northstar Supply Co.':'e.g. Jordan Lee' %>"></label><% if(supplier){ %><label
        class="span-2">Contact person<input name="contactName" maxlength="160" value="<%= contact?.contact_name||'' %>"
          placeholder="e.g. Alex Morgan"></label><% } %><label>Email address<input name="email" type="email" maxlength="254"
          value="<%= contact?.email||'' %>" placeholder="you@example.com"></label><label>Phone number<input name="phone" type="tel"
          maxlength="40" value="<%= contact?.phone||'' %>" placeholder="+1 555 0100"></label><label class="span-2">Address<textarea
          name="address" maxlength="500" rows="3"
          placeholder="Street address, city, postal code"><%= contact?.address||'' %></textarea></label></div><% if(supplier){ %><div
      class="form-section">
      <h2>Associated products</h2>
      <p class="section-subtitle">Choose the products this supplier can provide for purchase orders.</p><input type="hidden"
        name="productIds" value="">
      <div class="checkbox-list"><% products.forEach(p=>{ %><label><input type="checkbox" name="productIds" value="<%= p.id %>"
            <%= selectedProducts.includes(p.id)?'checked':'' %>><%= p.name %> <span class="muted">(<%= p.sku %>)</span></label><% }) %>
      </div>
    </div><% } %><div class="form-actions"><a class="button" href="/<%= type %>">Cancel</a><button
        class="button primary"><%- icon('check') %>Save <%= type.slice(0,-1) %></button></div>
  </form>
  <aside class="card info-card"><span class="backup-card-icon"><%- icon(supplier?'truck':'users') %></span>
    <h2>More than a contact.</h2>
    <p>
      <%= supplier?'Supplier profiles connect your product catalogue with purchase orders, so you can see who supplies what and track every restock.':'Every order is linked to a customer profile. View their complete order history and confirmed sales from one page.' %>
    </p>
  </aside>
</div><%- include('partials/end') %>