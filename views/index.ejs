<!doctype html>
<html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><link rel="stylesheet" href="/styles.css"><title>Inventory & Orders</title></head>
<body><main><h1>Inventory &amp; Orders</h1><p>Create a confirmed order to update stock immediately.</p>
<% if (error) { %><p class="error"><%= error %></p><% } %>
<nav><a href="/">Dashboard</a><a href="/orders">All orders</a></nav>
<section><h2>Current inventory</h2><form class="search" method="get" action="/"><label>Find a product <input name="q" value="<%= query %>" placeholder="SKU or name"></label><button>Search</button><a href="/">Clear</a></form><table><thead><tr><th>SKU</th><th>Product</th><th>Price</th><th>In stock</th><th>Status</th><th>Restock</th><th>Manage</th></tr></thead><tbody><% products.forEach(product => { %><tr><td><%= product.sku %></td><td><%= product.name %></td><td>$<%= product.unit_price.toFixed(2) %></td><td><%= product.stock_quantity %></td><td><%= product.stock_quantity <= product.reorder_level ? 'Low stock' : 'Available' %></td><td><form class="inline" method="post" action="/products/<%= product.id %>/restock"><input aria-label="Restock <%= product.name %>" type="number" name="quantity" min="1" value="1"><button>Restock</button></form></td><td><a href="/products/<%= product.id %>/edit">Edit</a><form class="inline" method="post" action="/products/<%= product.id %>/deactivate"><button class="danger">Deactivate</button></form></td></tr><% }) %></tbody></table><% if (!products.length) { %><p>No active products match this search.</p><% } %></section>
<section><h2>Create order</h2><form method="post" action="/orders"><label>Customer name <input name="customerName" required></label><div id="lines"><div class="line"><label>Product <select name="productId"><% products.forEach(product => { %><option value="<%= product.id %>"><%= product.name %> (<%= product.stock_quantity %> available)</option><% }) %></select></label><label>Quantity <input type="number" name="quantity" min="1" value="1" required></label></div></div><button type="button" id="add-line">Add another product</button><button>Confirm order</button></form></section>
<section><h2>Add product</h2><form method="post" action="/products"><label>SKU <input name="sku" required></label><label>Product name <input name="name" required></label><label>Unit price <input name="unitPrice" type="number" min="0" step="0.01" required></label><label>Opening stock <input name="stockQuantity" type="number" min="0" value="0" required></label><label>Reorder level <input name="reorderLevel" type="number" min="0" value="0" required></label><button>Add product</button></form></section>
<section><h2>Recent orders</h2><% if (recentOrders.length) { %><table><thead><tr><th>Order</th><th>Customer</th><th>Status</th><th>Total</th></tr></thead><tbody><% recentOrders.forEach(order => { %><tr><td><a href="/orders/<%= order.id %>">#<%= order.id %></a></td><td><%= order.customer_name %></td><td><%= order.status %></td><td>$<%= order.total_amount.toFixed(2) %></td></tr><% }) %></tbody></table><% } else { %><p>No orders yet.</p><% } %></section>
<script>document.getElementById('add-line').addEventListener('click', () => { const first = document.querySelector('.line'); const line = first.cloneNode(true); line.querySelector('input').value = 1; document.getElementById('lines').append(line); });</script>
</main></body></html>
