<!doctype html><html lang="en"><head><meta charset="utf-8"><link rel="stylesheet" href="/styles.css"><title>Edit product</title></head><body><main><nav><a href="/">Dashboard</a><a href="/orders">All orders</a></nav><h1>Edit product</h1><p>Current stock: <strong><%= product.stock_quantity %></strong>. Use restocking on the dashboard to change stock and retain the audit trail.</p><% if (error) { %><p class="error"><%= error %></p><% } %><form method="post" action="/products/<%= product.id %>"><label>SKU <input name="sku" value="<%= product.sku %>" required></label><label>Product name <input name="name" value="<%= product.name %>" required></label><label>Unit price <input name="unitPrice" type="number" min="0" step="0.01" value="<%= product.unit_price %>" required></label><label>Reorder level <input name="reorderLevel" type="number" min="0" value="<%= product.reorder_level %>" required></label><button>Save changes</button></form></main></body></html>
