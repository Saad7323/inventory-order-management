<% if(typeof user!=='undefined' && user && typeof icon!=='undefined'){ %><%- include('partials/start',{active:typeof active==='undefined'?'':active}) %>
<div class="error-page">
  <div class="error-page-inner"><span class="empty-symbol"><%- icon('alert') %></span>
    <h1><%= title %><span class="title-dot">.</span></h1>
    <p><%= message %></p><a class="button primary" href="<%= typeof returnPath!=='undefined'?returnPath:'/' %>">Return to workspace</a>
  </div>
</div><%- include('partials/end') %><% } else { %>
<!doctype html>
<html lang="en">

<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width,initial-scale=1">
  <title><%= title %> · StockPilot</title>
  <link rel="stylesheet" href="/styles.css">
</head>

<body>
  <main class="error-page">
    <div class="error-page-inner">
      <h1><%= title %></h1>
      <p><%= message %></p><a class="button primary" href="/">Return to workspace</a>
    </div>
  </main>
</body>

</html><% } %>