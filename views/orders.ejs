<%- include('partials/start') %>
<section class="page-heading">
  <div>
    <div class="eyebrow">EVERY ORDER, ACCOUNTED FOR</div>
    <h1>Sales orders<span class="title-dot">.</span></h1>
    <p>From the first item to the final confirmation.</p>
  </div>
  <div class="heading-actions"><a class="button"
      href="/export/orders<%= Object.keys(query).length?'?'+new URLSearchParams(query):'' %>"><%- icon('down') %>Export CSV</a><a
      class="button primary" href="/orders/new"><%- icon('plus') %>Create order</a></div>
</section>
<section class="card">
  <div class="table-toolbar">
    <nav class="tabs" aria-label="Order status">
      <% [['','All orders'],['confirmed','Confirmed'],['cancelled','Cancelled']].forEach(([key,label])=>{ %><a
        class="tab <%= (query.status||'')===key?'selected':'' %>" href="<%= url({status:key,page:1}) %>"><%= label %></a><% }) %></nav>
    <form class="table-search" method="get"><%- icon('search') %><input name="q" placeholder="Customer or order number..."
        aria-label="Search orders"
        value="<%= query.q||'' %>"><% Object.entries(query).filter(([key])=>!['q','page','notice'].includes(key)).forEach(([key,value])=>{ %><input
        type="hidden" name="<%= key %>" value="<%= value %>"><% }) %></form>
  </div>
  <form method="get" class="filter-panel"><input type="hidden" name="q" value="<%= query.q||'' %>"><input type="hidden" name="status"
      value="<%= query.status||'' %>"><label>Customer<select name="customer">
        <option value="">All customers</option><% customers.forEach(c=>{ %><option value="<%= c.id %>"
          <%= Number(query.customer)===c.id?'selected':'' %>><%= c.name %></option><% }) %>
      </select></label><label>From<input type="date" name="from" value="<%= query.from||'' %>"></label><label>To<input type="date" name="to"
        value="<%= query.to||'' %>"></label><label>Min. total<input type="number" name="minTotal" min="0" step=".01" placeholder="$0.00"
        value="<%= query.minTotal||'' %>"></label><label>Max. total<input type="number" name="maxTotal" min="0" step=".01"
        placeholder="No limit" value="<%= query.maxTotal||'' %>"></label><label>Sort by<select name="sort">
        <option value="date">Newest first</option>
        <option value="total" <%= query.sort==='total'?'selected':'' %>>Highest total</option>
      </select></label><button class="button primary">Apply</button><a href="/orders" class="text-link">Reset</a></form>
  <div class="table-scroll">
    <table>
      <thead>
        <tr>
          <th>Order</th>
          <th>Customer</th>
          <th>Placed on</th>
          <th>Status</th>
          <th class="numeric">Units</th>
          <th class="numeric">Total</th>
          <th></th>
        </tr>
      </thead>
      <tbody><% result.rows.forEach(order=>{ %><tr>
          <td><a class="text-link" href="/orders/<%= order.id %>">#SO-<%= String(order.id).padStart(4,'0') %></a></td>
          <td><a href="/customers/<%= order.customer_id %>"><%= order.customer_name %></a></td>
          <td class="date-cell"><%= datetime(order.created_at) %></td>
          <td><span class="badge <%= order.status %>"><i></i><%= statusLabel(order.status) %></span></td>
          <td class="numeric"><%= number(order.units) %></td>
          <td class="numeric value-cell"><%= money(order.total_amount) %></td>
          <td><a class="icon-button" href="/orders/<%= order.id %>" aria-label="View order <%= order.id %>"><%- icon('chevron') %></a></td>
        </tr><% }) %></tbody>
    </table>
  </div><% if(!result.rows.length){ %><div class="empty-state"><%- icon('orders') %><h3>
      <%= result.total?'No matching orders':'Your orders will live here' %></h3>
    <p>Create an order or try a different set of filters.</p><a class="button primary" href="/orders/new">Create order</a>
  </div><% } %><%- include('partials/pagination',{result,noun:'orders'}) %>
</section>
<%- include('partials/end') %>