<!doctype html><html lang="en"><head><meta charset="utf-8"><link rel="stylesheet" href="/styles.css"><title>Orders</title></head><body><main><nav><a href="/">Dashboard</a><a href="/orders">All orders</a></nav><h1>All orders</h1><% if (orders.length) { %><table><thead><tr><th>Order</th><th>Customer</th><th>Status</th><th>Total</th><th>Created</th></tr></thead><tbody><% orders.forEach(order => { %><tr><td><a href="/orders/<%= order.id %>">#<%= order.id %></a></td><td><%= order.customer_name %></td><td><%= order.status %></td><td>$<%= order.total_amount.toFixed(2) %></td><td><%= order.created_at %></td></tr><% }) %></tbody></table><% } else { %><p>No orders yet.</p><% } %></main></body></html>
